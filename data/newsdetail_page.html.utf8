  <script>
    if(window.location.href.split('goback=').length>1&&window.location.href.split('goback=')[1].split("&")[0] !== '') {
        var gobackUrl = window.location.href.split('goback=')[1].split("&")[0];
    }else {
        var gobackUrl = 'news';
    }
    var pageName = '';
    switch (gobackUrl) {
      case 'main':
        pageName = '回到首页';
        break;
      case 'news':
        pageName = '回到新闻页';
        break;
      default:
        break;
    }
    $('.gobacknews span').text(pageName);
    $('.gobacknews').attr('href', `./${gobackUrl}.html`);
    $('.goback-news').text(pageName);
    $('.goback-news').attr('href', `./${gobackUrl}.html`);

    if (gobackUrl === 'news') {
      $('.goback-news').attr('href', `javascript:;`).on('click', function () {
        window.history.go(-1);
      });
      $('.gobacknews').attr('href', `javascript:;`).on('click', function () {
        window.history.go(-1);
      });
    }

    if (!/(iPhone|iPad|iPod|iOS|Android|Windows Phone|BlackBerry|SymbianOS)/i.test(navigator.userAgent)) {
      // PC逻辑
      window.newsSwiper = new Swiper('.news-relevant .swiper', {
        slidesPerView: 'auto',
        spaceBetween: 29,
        slidesPerGroup: 4,
        init: false,
        pagination: {
          el: '.swiper-pagination',
          bulletElement: 'li',
          clickable: true,
        }
      })
      // 滚动隐藏
      $(window).on('scroll', function () {
        if (document.documentElement.scrollTop > 300) {
          $('.gotop').fadeIn();
        } else {
          $('.gotop').fadeOut();
        }
      })
    } else {
      // H5逻辑
      window.newsSwiper = new Swiper('.news-relevant .swiper', {
        slidesPerView: 'auto',
        spaceBetween: 200,
        centeredSlides: true,
        init: false,
        pagination: {
          el: '.swiper-pagination',
          bulletElement: 'li',
          clickable: true,
        }
      })
    }
  </script>
  <script src="//game.gtimg.cn/images/js/plugin/report/atReport.js" charset="UTF-8"></script>
  <script>
    if (typeof (pgvMain) == 'function') pgvMain(); //千万不能忘记！
    var setSite = {
      siteType: "os", //必填项:"os"代表是官网，如果不是，则填写actName例如a20160701xxx
      pageType: "newsdetails", //必填项:本页面的定位；按照页面含义填写例如main||list||detail||download||share||page1||pageN,不支持点(.)、下划线(_)
      project: "base", //选填项:如果是官网模块则是必填;按照模块内容，填写固定的对应值;官网微社区base;同人站doujin;赛事match;故事站story;文化站history;粉丝站fans;爆料站coming;论坛bbs;皮肤skin;默认other;
      autoClick: true, //是否自动上报button或者a标签的点击。选填项：默认false
      autoAreaStay: true, //是否自动上报dom中填写dt-areaid的区域停留时长。选填项：默认false
    };
    if (typeof LOL_SEND_DATA_FN_AT == 'function') {
      LOL_SEND_DATA_FN_AT();
    }
  </script>
