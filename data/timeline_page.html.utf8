<script>
const getTimeLineData = window.VersionTimeline_List;
var TimeLine_html='';
var slider_a=0;
var slider_b=0;
 
$.each(getTimeLineData, function(key, value) {
    
    var v_link=getTimeLineData[key].link;
    //链接为空的情况
    if(v_link==''){
        v_link="javascript:;";
    }else{
        v_link=getTimeLineData[key].link
    };
//onclick="LOLSendClickAT('btn','link`+key+`','`+getTimeLineData[key].title+`');open_page('`+v_link+`')"
    //大版本
    if(getTimeLineData[key].isMajor==1){
        TimeLine_html+=`
        <div class="swiper-slide slide_a"><div class="date"><span class="d_l">`+getTimeLineData[key].date+`</span><span class="d_r">`+getTimeLineData[key].year+`</span></div><div class="bg img" style='background-image:url(`+getTimeLineData[key].pic+`)'><a class="link`+key+`" href="`+v_link+`" target="_blank" onclick="LOLSendClickAT('btn','link`+key+`','`+getTimeLineData[key].title+`')"><p class="name">`+getTimeLineData[key].title+`</p></a></div>
        <i class="icon"></i><div class="time">`+getTimeLineData[key].date+`</div><div class="info"><p>`+getTimeLineData[key].desc1+`</p><p>`+getTimeLineData[key].desc2+`</p><p>`+getTimeLineData[key].desc3+`</p></div></div>`;
        slider_a++;
    }
    //小版本
    else{
       TimeLine_html+=`<div class="swiper-slide slide_b"><a class="link`+key+`" href="`+v_link+`" target="_blank" onclick="LOLSendClickAT('btn','link`+key+`','`+getTimeLineData[key].title+`')"><span class="m_time">`+getTimeLineData[key].date+`</span><em>`+getTimeLineData[key].title+`</em></a><i class="icon"></i><div class="time">`+getTimeLineData[key].date+`</div><div class="info"><p>`+getTimeLineData[key].desc1+`</p><p>`+getTimeLineData[key].desc2+`</p><p>`+getTimeLineData[key].desc3+`</p></div></div>`;
       slider_b++
    };
});

//计算长度 swiper-wrapper
var swiper_width=195*slider_b+917*slider_a+30*(slider_b+slider_a);
$('.swiper-wrapper').css('width',swiper_width+'px');


$('#Time_line_list').html(TimeLine_html);

if(isPC()){
    var swiper = new Swiper(".mySwiper", {
    observer: true, 
    observeParents: true, 
    slidesPerView:"auto",
    freeMode: true,    
    navigation: {
        nextEl: ".next_btn",
        prevEl: ".prev_btn",
      },
});
swiper.update();          // 更新幻灯片数量?:ml-citation{ref="4,5" data="citationList"}
// var right_w=swiper_width-($(document.body).width()-200);
// $('#Time_line_list').css('transform','translateX(-'+right_w+'px)')
swiper.slideTo(swiper.slides.length - 2, 0)
} 
//此段代码不能放到外链JS中，
var setSite = { //设置网站属性
    siteType: "a20250228timeline", //必填项:"os"代表是官网，如果不是，则填写actName例如a20160701xxx
    pageType: "index", //必填项:本页面的定位；按照页面含义填写例如main||list||detail||download||share||page1||pageN,不支持点(.)、下划线(_)
    project: "base", //选填项:如果是官网模块则是必填;按照模块内容，填写固定的对应值;官网或微社区base;同人站doujin;赛事match;故事站story;文化站history;粉丝站fans;爆料站coming;论坛bbs;皮肤skin;默认other;
    ingame: false,//选填项:默认根据浏览器类型获取是否属于游戏内，因英雄联盟端游客户端特殊性，所以英雄联盟端游客户端需求需要填写true.
    autoClick: false,//是否自动上报按钮&a的点击。选填项：默认false。非必要不开启
    autoAreaStay: false,//是否自动上报dom中填写dt-areaid的区域停留时长。选填项：默认false。非必要不开启
};
if (typeof LOL_SEND_DATA_FN_AT == 'function') {
    LOL_SEND_DATA_FN_AT();
};//千万不能忘记！
</script>
<style>#afooter{display:block!important}</style>
